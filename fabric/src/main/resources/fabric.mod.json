{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "${description}",
  "authors": [
    "${mod_author}"
  ],
  "contributors": [
    "anvian"
  ],
  "contact": {
    "homepage": "https://modrinth.com/mod/chiseledbookshelfvisualizer",
    "sources": "https://github.com/anviaan/Chiseled-Bookshelf-Visualizer",
    "issues": "https://github.com/anviaan/Chiseled-Bookshelf-Visualizer/issues"
  },
  "license": "${license}",
  "icon": "${mod_id}.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "net.anvian.chiseledbookshelfvisualizer.FabricMod"
    ],
    "client": [
      "net.anvian.chiseledbookshelfvisualizer.FabricClient"
    ],
    "modmenu": [
      "net.anvian.chiseledbookshelfvisualizer.client.config.ModMenuIntegration"
    ]
  },
  "custom": {
    "modmenu": {
      "links": {
        "modmenu.curseforge": "https://www.curseforge.com/minecraft/mc-mods/chiseledbookshelfvisualizer",
        "modmenu.modrinth": "https://modrinth.com/mod/chiseledbookshelfvisualizer"
      }
    }
  },
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "fabric-api": "*",
    "minecraft": "~${minecraft_version}",
    "java": ">=${java_version}",
    "cloth-config": ">=${cloth_config_version}",
    "anvianslib": ">=${anvianslib_version}"
  },
  "suggests": {
    "modmenu": ">=${modmenu_version}"
  }
}
